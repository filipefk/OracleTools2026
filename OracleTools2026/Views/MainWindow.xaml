<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OracleTools2026.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Oracle Tools">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="L" Invoked="ConnectAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="NewInstanceAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <TitleBar x:Name="AppTitleBar" Title="Oracle Tools"
                  IsBackButtonVisible="False" IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///OracleTools.ico" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,0">
                    <Button x:Name="ConnectionButton" Click="ConnectButton_Click" Height="32"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Conectar (Ctrl+L). A conexão é compartilhada por todas as ferramentas desta janela.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="ConnectionIcon" Glyph="&#xE703;" FontSize="14" />
                            <TextBlock x:Name="ConnectionText" Text="Não conectado" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="NewInstanceButton_Click" Height="32" Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Nova instância (Ctrl+N): outro processo, com a sua própria conexão">
                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView x:Name="NavView" Grid.Row="1"
                        IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="True" IsTitleBarAutoPaddingEnabled="False"
                        PaneDisplayMode="Left" OpenPaneLength="280"
                        SelectionChanged="NavView_SelectionChanged">
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
