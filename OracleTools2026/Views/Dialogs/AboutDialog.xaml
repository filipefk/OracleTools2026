<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OracleTools2026.Views.Dialogs.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OracleTools2026.Views.Dialogs"
    Title="Sobre"
    PrimaryButtonText="Copiar informações"
    CloseButtonText="Fechar"
    DefaultButton="Close"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Spacing="16" Width="520">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Image Source="ms-appx:///OracleTools.ico" Width="48" Height="48" VerticalAlignment="Center" />
            <TextBlock x:Name="ProductText" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

        <StackPanel Spacing="4">
            <ItemsControl x:Name="InfoList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:AboutProperty">
                        <Grid ColumnSpacing="16" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnSpacing="16" Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Fontes" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <HyperlinkButton x:Name="SourceLink" Grid.Column="1" Padding="0" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <TextBlock x:Name="CopyrightText" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</ContentDialog>
