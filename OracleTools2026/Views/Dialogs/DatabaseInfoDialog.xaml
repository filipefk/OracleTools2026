<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OracleTools2026.Views.Dialogs.DatabaseInfoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OracleTools2026.Models"
    xmlns:local="using:OracleTools2026.Views.Dialogs"
    Title="Informações do banco"
    PrimaryButtonText="Copiar"
    CloseButtonText="Fechar"
    DefaultButton="Close"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">800</x:Double>
        <CollectionViewSource x:Name="GroupedProperties" IsSourceGrouped="True" />
    </ContentDialog.Resources>

    <Grid RowSpacing="8" Width="760">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Copiar copia as linhas selecionadas ou, sem seleção, todas." />
        <ListView x:Name="PropertiesList" Grid.Row="1" Height="520" SelectionMode="Extended"
                  ItemsSource="{x:Bind GroupedProperties.View}">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="local:DatabasePropertyGroup">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DatabaseProperty">
                    <Grid ColumnSpacing="16" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
