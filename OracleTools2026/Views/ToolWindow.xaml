<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OracleTools2026.Views.ToolWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///OracleTools.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Frame x:Name="ContentFrame" Grid.Row="1" />
    </Grid>
</Window>
