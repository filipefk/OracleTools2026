<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OracleTools2026.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:prefs="using:OracleTools2026.ViewModels.Preferences"
    xmlns:ui="using:OracleTools2026.UI">

    <Grid Padding="36,24,36,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Parâmetros" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Text="Preferências gravadas no registro (HKEY_CURRENT_USER\Software\ORACLE_Tools\Parametros), compartilhadas com o OracleTools original. As conexões salvas são encriptadas e não podem ser editadas aqui." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    <TextBlock Text="Salvar" />
                </StackPanel>
            </Button>
            <Button Content="Descartar alterações" Command="{x:Bind ViewModel.DiscardCommand}" />
            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ListView Grid.Row="2" SelectionMode="None" Padding="0,0,0,24"
                  ItemsSource="{x:Bind ViewModel.Items}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="prefs:SettingItem">
                    <toolkit:SettingsCard Header="{x:Bind FriendlyName}" Description="{x:Bind Name}">
                        <Grid>
                            <TextBox Width="420" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{x:Bind IsReadOnly}" TextWrapping="NoWrap"
                                     Visibility="{x:Bind IsText}"
                                     ToolTipService.ToolTip="{x:Bind Value, Mode=OneWay}" />
                            <ToggleSwitch IsOn="{x:Bind IsOn, Mode=TwoWay}" OnContent="Sim" OffContent="Não"
                                          Visibility="{x:Bind IsFlag}" />
                        </Grid>
                    </toolkit:SettingsCard>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
