<?xml version="1.0" encoding="utf-8"?>
<views:ToolPage
    x:Class="OracleTools2026.Views.Tools.LockMonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:OracleTools2026.Views"
    xmlns:controls="using:OracleTools2026.Controls"
    xmlns:ui="using:OracleTools2026.UI"
    xmlns:tv="using:WinUI.TableView">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="24,16,16,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.ToolTitle}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.ServerInfo, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent">
                <AppBarButton x:Name="Script1Button" Label="Script 1" Command="{x:Bind ViewModel.StartScript1Command}"
                              ToolTipService.ToolTip="Monitora com o ScriptLock01.sql (botão direito copia o script)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE768;" /></AppBarButton.Icon>
                    <AppBarButton.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Copiar script para a área de transferência" Click="CopyScript1_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.ContextFlyout>
                </AppBarButton>
                <AppBarButton x:Name="Script2Button" Label="Script 2" Command="{x:Bind ViewModel.StartScript2Command}"
                              ToolTipService.ToolTip="Monitora com o ScriptLock02.sql (botão direito copia o script)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE768;" /></AppBarButton.Icon>
                    <AppBarButton.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Copiar script para a área de transferência" Click="CopyScript2_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.ContextFlyout>
                </AppBarButton>
                <AppBarButton Label="Parar" Command="{x:Bind ViewModel.StopCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE71A;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Pasta dos scripts" Command="{x:Bind ViewModel.OpenScriptsFolderCommand}"
                              ToolTipService.ToolTip="Abre a pasta %APPDATA%\OracleTools2026, onde ficam o ScriptLock01.sql e o ScriptLock02.sql">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE838;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Conectar" Command="{x:Bind ViewModel.ConnectCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE703;" /></AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="L" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Label="Informações do banco" Command="{x:Bind ViewModel.ShowServerInfoCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE946;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <InfoBar Grid.Row="1" Margin="24,0,24,8"
                 IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
                 Severity="{x:Bind ui:BindingHelpers.Severity(ViewModel.NoticeKind), Mode=OneWay}"
                 Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" />

        <Border Grid.Row="2" Margin="24,0,24,8" Style="{StaticResource CardPanelStyle}">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <NumberBox Header="Intervalo (segundos)" Minimum="1" Maximum="3600" SmallChange="1" LargeChange="10"
                           SpinButtonPlacementMode="Inline" Width="180"
                           Value="{x:Bind ViewModel.IntervalSeconds, Mode=TwoWay}" />
                <CheckBox Grid.Column="1" VerticalAlignment="Bottom" Content="Avisar caso encontre lock"
                          ToolTipService.ToolTip="Traz a janela para a frente e emite um aviso sonoro quando o script retorna linhas"
                          IsChecked="{x:Bind ViewModel.NotifyWhenFound, Mode=TwoWay}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,6">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{ThemeResource SystemFillColorSuccessBrush}"
                             Visibility="{x:Bind ViewModel.IsMonitoring, Mode=OneWay}" />
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{ThemeResource TextFillColorTertiaryBrush}"
                             Visibility="{x:Bind ui:BindingHelpers.CollapsedWhen(ViewModel.IsMonitoring), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.MonitorStateText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <tv:TableView x:Name="LocksTable" Grid.Row="3" Margin="24,0,24,12"
                      Style="{StaticResource ToolTableViewStyle}"
                      ItemsSource="{x:Bind ViewModel.Rows.Items}">
            <tv:TableView.RowContextFlyout>
                <MenuFlyout />
            </tv:TableView.RowContextFlyout>
        </tv:TableView>

        <controls:ToolStatusBar Grid.Row="4" ViewModel="{x:Bind ViewModel}" />
    </Grid>
</views:ToolPage>
