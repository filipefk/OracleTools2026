<?xml version="1.0" encoding="utf-8"?>
<views:ToolPage
    x:Class="OracleTools2026.Views.Tools.ExtractDdlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:OracleTools2026.Views"
    xmlns:controls="using:OracleTools2026.Controls"
    xmlns:ui="using:OracleTools2026.UI"
    xmlns:vm="using:OracleTools2026.ViewModels.ExtractDdl"
    xmlns:tv="using:WinUI.TableView">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="24,16,16,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.ToolTitle}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.ServerInfo, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent">
                <AppBarButton Label="Listar" Command="{x:Bind ViewModel.SearchCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE721;" /></AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="F5" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Label="Últimas compilações" Command="{x:Bind ViewModel.ListRecentCommand}"
                              ToolTipService.ToolTip="Objetos alterados nos últimos dias (campo Dias)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE81C;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Listar inválidos" Command="{x:Bind ViewModel.ListInvalidCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE783;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Extrair DDL" Command="{x:Bind ViewModel.ExtractCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE896;" /></AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="Recompilar inválidos" Command="{x:Bind ViewModel.RecompileInvalidCommand}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE895;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton Label="Conectar" Command="{x:Bind ViewModel.ConnectCommand}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE703;" /></AppBarButton.Icon>
                        <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="L" /></AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarButton Label="Informações do banco" Command="{x:Bind ViewModel.ShowServerInfoCommand}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE946;" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <InfoBar Grid.Row="1" Margin="24,0,24,8"
                 IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
                 Severity="{x:Bind ui:BindingHelpers.Severity(ViewModel.NoticeKind), Mode=OneWay}"
                 Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" />

        <!-- Filtros -->
        <Border Grid.Row="2" Margin="24,0,24,8" Style="{StaticResource CardPanelStyle}">
            <ContentControl IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="OwnerBox" Header="Owner" PlaceholderText="Todos"
                                    Text="{x:Bind ViewModel.Owner, Mode=TwoWay}"
                                    TextChanged="OwnerBox_TextChanged"
                                    SuggestionChosen="OwnerBox_SuggestionChosen"
                                    GotFocus="OwnerBox_GotFocus"
                                    QuerySubmitted="OwnerBox_QuerySubmitted" />
                    <ComboBox Grid.Column="1" Header="Tipo" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.Types}"
                              SelectedItem="{x:Bind ViewModel.SelectedType, Mode=TwoWay}" />
                    <TextBox Grid.Column="2" Header="Nome" PlaceholderText="parte do nome" CharacterCasing="Upper"
                             Text="{x:Bind ViewModel.NameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="FilterBox_KeyDown" />
                    <NumberBox Grid.Column="3" Header="Dias" Minimum="1" Maximum="3650" SmallChange="1" LargeChange="15"
                               SpinButtonPlacementMode="Compact"
                               ToolTipService.ToolTip="Período de Últimas compilações"
                               Value="{x:Bind ViewModel.Days, Mode=TwoWay}" />
                </Grid>
            </ContentControl>
        </Border>

        <!-- Lista de objetos e lista digitada -->
        <Grid Grid.Row="3" Margin="24,0,24,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,6">
                <CheckBox Content="Selecionar todos" IsThreeState="False"
                          IsChecked="{x:Bind ViewModel.Objects.AllChecked, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <tv:TableView x:Name="ObjectsTable" Grid.Row="1"
                          Style="{StaticResource ToolTableViewStyle}"
                          ItemsSource="{x:Bind ViewModel.Objects.Items}">
                <tv:TableView.RowContextFlyout>
                    <MenuFlyout />
                </tv:TableView.RowContextFlyout>
                <tv:TableView.ConditionalCellStyles>
                    <tv:TableViewConditionalCellStyle Predicate="{x:Bind IsInvalid}" Style="{StaticResource CriticalCellStyle}" />
                </tv:TableView.ConditionalCellStyles>
                <tv:TableView.Columns>
                    <tv:TableViewTemplateColumn Header="" Width="48" CanSort="False" CanFilter="False" CanResize="False">
                        <tv:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:DatabaseObjectItem">
                                <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0" Padding="0" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </tv:TableViewTemplateColumn.CellTemplate>
                    </tv:TableViewTemplateColumn>
                    <tv:TableViewTextColumn Header="Owner" Binding="{Binding Owner}" />
                    <tv:TableViewTextColumn Header="Nome" Binding="{Binding Name}" />
                    <tv:TableViewTextColumn Header="Tipo" Binding="{Binding Type}" />
                    <tv:TableViewTextColumn Header="Data criação" Binding="{Binding CreatedAtText}" SortMemberPath="CreatedAt" />
                    <tv:TableViewTextColumn Header="Data alteração" Binding="{Binding LastDdlAtText}" SortMemberPath="LastDdlAt" />
                    <tv:TableViewTextColumn Header="Status" Binding="{Binding Status}" />
                    <tv:TableViewTextColumn Header="Mensagem" Binding="{Binding ErrorText}" />
                </tv:TableView.Columns>
            </tv:TableView>

            <TextBlock Grid.Column="1" Text="Lista de objetos (OWNER.NOME, um por linha)" Margin="0,0,0,6" VerticalAlignment="Bottom" />
            <TextBox Grid.Column="1" Grid.Row="1" Style="{StaticResource MonospaceTextBoxStyle}" CharacterCasing="Upper"
                     Text="{x:Bind ViewModel.ManualList, Mode=TwoWay}"
                     IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
        </Grid>

        <!-- Opções de extração -->
        <Border Grid.Row="4" Margin="24,0,24,12" Style="{StaticResource CardPanelStyle}">
            <ContentControl IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButtons Header="Extrair de" SelectedIndex="{x:Bind ViewModel.SourceIndex, Mode=TwoWay}">
                        <x:String>Objetos marcados</x:String>
                        <x:String>Toda a lista</x:String>
                        <x:String>Lista digitada</x:String>
                    </RadioButtons>
                    <RadioButtons Grid.Column="1" Header="Destino" SelectedIndex="{x:Bind ViewModel.DestinationIndex, Mode=TwoWay}">
                        <x:String>Arquivos na pasta</x:String>
                        <x:String>Área de transferência</x:String>
                        <x:String>Editor de texto</x:String>
                    </RadioButtons>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Pasta" Text="{x:Bind ViewModel.OutputFolder, Mode=TwoWay}"
                                     IsEnabled="{x:Bind ViewModel.IsFileDestination, Mode=OneWay}"
                                     ToolTipService.ToolTip="Os arquivos são gravados em Owner, Tipo, OWNER.NOME.ext dentro da pasta" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.BrowseFolderCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsFileDestination, Mode=OneWay}"
                                    ToolTipService.ToolTip="Escolher a pasta">
                                <FontIcon Glyph="&#xED25;" FontSize="16" />
                            </Button>
                        </Grid>
                        <CheckBox Content="Incluir cabeçalho com dados do objeto e da conexão"
                                  IsChecked="{x:Bind ViewModel.IncludeHeader, Mode=TwoWay}" />
                        <CheckBox Content="Incluir mensagens de erro de compilação nas linhas"
                                  IsChecked="{x:Bind ViewModel.InlineCompileErrors, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </ContentControl>
        </Border>

        <controls:ToolStatusBar Grid.Row="5" ViewModel="{x:Bind ViewModel}" />
    </Grid>
</views:ToolPage>
