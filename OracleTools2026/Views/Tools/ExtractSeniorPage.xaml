<?xml version="1.0" encoding="utf-8"?>
<views:ToolPage
    x:Class="OracleTools2026.Views.Tools.ExtractSeniorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:OracleTools2026.Views"
    xmlns:controls="using:OracleTools2026.Controls"
    xmlns:ui="using:OracleTools2026.UI"
    xmlns:vm="using:OracleTools2026.ViewModels.ExtractSenior"
    xmlns:tv="using:WinUI.TableView">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="24,16,16,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.ToolTitle}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.ServerInfo, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent">
                <AppBarButton Label="Listar" Command="{x:Bind ViewModel.ListCommand}"
                              ToolTipService.ToolTip="Mostra os itens que serão exportados, para conferir e marcar">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE721;" /></AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="F5" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Label="Exportar" Command="{x:Bind ViewModel.ExtractCommand}"
                              ToolTipService.ToolTip="Grava os itens marcados (ou todos, se a lista não foi carregada)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Abrir pasta" Command="{x:Bind ViewModel.OpenFolderCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE838;" /></AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="Conectar" Command="{x:Bind ViewModel.ConnectCommand}" KeyboardAcceleratorPlacementMode="Hidden">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE703;" /></AppBarButton.Icon>
                        <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="L" /></AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarButton Label="Informações do banco" Command="{x:Bind ViewModel.ShowServerInfoCommand}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE946;" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <InfoBar Grid.Row="1" Margin="24,0,24,8"
                 IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
                 Severity="{x:Bind ui:BindingHelpers.Severity(ViewModel.NoticeKind), Mode=OneWay}"
                 Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" />

        <!-- Origem, artefatos e destino -->
        <Border Grid.Row="2" Margin="24,0,24,8" Style="{StaticResource CardPanelStyle}">
            <Grid ColumnSpacing="24" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Header="Schema do Senior" HorizontalAlignment="Stretch"
                              IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                              ItemsSource="{x:Bind ViewModel.Owners}"
                              SelectedItem="{x:Bind ViewModel.SelectedOwner, Mode=TwoWay}"
                              DropDownOpened="OwnerComboBox_DropDownOpened"
                              ToolTipService.ToolTip="Schemas que têm a tabela R960SRV. A exportação só lê o banco (SELECT) e nunca lê a R960PRV, que guarda credenciais." />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.RefreshOwnersCommand}"
                            ToolTipService.ToolTip="Procurar de novo os schemas">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                </Grid>

                <Grid Grid.Column="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Header="Pasta do repositório"
                             IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                             Text="{x:Bind ViewModel.OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTipService.ToolTip="Arquivos em UTF-8 com fim de linha LF, em ordem estável e sem campos voláteis. Na exportação completa, arquivos das pastas exportadas que não vierem do banco são apagados, após confirmação." />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.BrowseFolderCommand}"
                            ToolTipService.ToolTip="Escolher a pasta">
                        <FontIcon Glyph="&#xED25;" FontSize="16" />
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" Text="{x:Bind ViewModel.RootFolderText, Mode=OneWay}" />

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="24">
                    <CheckBox IsChecked="{x:Bind ViewModel.IncludeWebServices, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                              Content="Webservices"
                              ToolTipService.ToolTip="Serviços, portas, parâmetros e fonte das regras (exceto com.senior.*) e dependencias.yaml" />
                    <CheckBox IsChecked="{x:Bind ViewModel.IncludeCbds, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                              Content="CBDS"
                              ToolTipService.ToolTip="Tabelas USU_T*, campos USU_* em tabelas padrão, listas e visões" />
                    <CheckBox IsChecked="{x:Bind ViewModel.IncludeRuleLinks, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                              Content="Vínculos de regras (E098REG)" />
                    <CheckBox IsChecked="{x:Bind ViewModel.IncludeTableDdl, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                              Content="DDL das tabelas USU_T*"
                              ToolTipService.ToolTip="DDL de referência (DBMS_METADATA, sem parâmetros de armazenamento)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Itens da exportação -->
        <Grid Grid.Row="3" Margin="24,0,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,6">
                <CheckBox Content="Selecionar todos" IsThreeState="False"
                          IsChecked="{x:Bind ViewModel.Items.AllChecked, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <tv:TableView x:Name="ItemsTable" Grid.Row="1"
                          Style="{StaticResource ToolTableViewStyle}"
                          ItemsSource="{x:Bind ViewModel.Items.Items}">
                <tv:TableView.RowContextFlyout>
                    <MenuFlyout />
                </tv:TableView.RowContextFlyout>
                <tv:TableView.ConditionalCellStyles>
                    <tv:TableViewConditionalCellStyle Predicate="{x:Bind IsError}" Style="{StaticResource CriticalCellStyle}" />
                    <tv:TableViewConditionalCellStyle Predicate="{x:Bind IsWritten}" Style="{StaticResource SuccessCellStyle}" />
                    <tv:TableViewConditionalCellStyle Predicate="{x:Bind IsMuted}" Style="{StaticResource MutedCellStyle}" />
                </tv:TableView.ConditionalCellStyles>
                <tv:TableView.Columns>
                    <tv:TableViewTemplateColumn Header="" Width="48" CanSort="False" CanFilter="False" CanResize="False">
                        <tv:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:SeniorItem">
                                <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0" Padding="0" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </tv:TableViewTemplateColumn.CellTemplate>
                    </tv:TableViewTemplateColumn>
                    <tv:TableViewTextColumn Header="Tipo" Binding="{Binding KindText}" />
                    <tv:TableViewTextColumn Header="Nome" Binding="{Binding Name}" />
                    <tv:TableViewTextColumn Header="Detalhe" Binding="{Binding Detail}" />
                    <tv:TableViewTextColumn Header="Última alteração" Binding="{Binding LastChangeText}" SortMemberPath="LastChange" />
                    <tv:TableViewTextColumn Header="Situação" Binding="{Binding StatusText}" SortMemberPath="Status" />
                    <tv:TableViewTextColumn Header="Mensagem" Binding="{Binding Message}" />
                </tv:TableView.Columns>
            </tv:TableView>
        </Grid>

        <controls:ToolStatusBar Grid.Row="4" ViewModel="{x:Bind ViewModel}" />
    </Grid>
</views:ToolPage>
