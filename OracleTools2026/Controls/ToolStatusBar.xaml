<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OracleTools2026.Controls.ToolStatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:OracleTools2026.UI">

    <!-- Rodapé das ferramentas: status, progresso da operação em andamento e botão Cancelar. -->
    <Grid Padding="16,6" ColumnSpacing="12" MinHeight="40"
          Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}" />

        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind ExtraText, Mode=OneWay}"
                   Visibility="{x:Bind ui:BindingHelpers.VisibleWhenNotEmpty(ExtraText), Mode=OneWay}" />

        <ProgressBar Grid.Column="2" Width="220" VerticalAlignment="Center"
                     IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                     Maximum="{x:Bind ViewModel.ProgressMaximum, Mode=OneWay}"
                     Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <Button Grid.Column="3" Content="Cancelar"
                Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
            <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" />
            </Button.KeyboardAccelerators>
        </Button>
    </Grid>
</UserControl>
